APP_DEBUG = false
APP_HOST = https://oa.example.com

DB_DRIVER = mysql
DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = <database-password>
DB_PORT = 3306
DB_CHARSET = utf8

CACHE_DRIVER = file
CACHE_PREFIX = oa:

COOKIE_SECURE = true
COOKIE_HTTPONLY = true
COOKIE_SAMESITE = lax
SESSION_NAME = OA_THINKPHP_SESSID

REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWD = <redis-password-if-required>
REDIS_DB = 0
REDIS_TIMEOUT = 0
REDIS_EXPIRE = 0

DEFAULT_LANG = zh-cn

OA_LEGACY_SM4_KEY_HEX = <32-hex-characters-from-secure-runtime-secret>
